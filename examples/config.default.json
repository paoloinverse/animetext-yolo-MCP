{
  "schema_version": "1.2",
  "detection": {
    "model": "yolo12m_animetext",
    "iou_threshold": 0.35,
    "score_threshold": 0.05,
    "allow_dynamic": false
  },
  "ocr": {
    "device": "auto",
    "max_patches": "auto",
    "batch_size": 16,
    "max_new_tokens": 128,
    "crop_padding_px": 2,
    "normalize_nfkc": false
  },
  "pipeline": {
    "reading_order": "manga_rtl",
    "min_box_area_px": 16
  },
  "gui": {
    "overlay_visible": true,
    "fill_opacity": 0.18,
    "labels_visible": true,
    "hover_opacity": 0.5,
    "zoom_mode": "fit",
    "zoom_percent": 100
  },
  "mcp": {
    "enabled": true,
    "transport": "streamable-http",
    "host": "127.0.0.1",
    "port": 8765,
    "auth_token": null,
    "log_capacity": 200
  },
  "paths": {
    "hf_cache_dir": null,
    "last_image_dir": null,
    "export_dir": null,
    "models_dir": null,
    "offline": false
  },
  "hf": {
    "token_env": "HF_TOKEN"
  }
}
